#!/usr/bin/env bash
# pre-push: lokalna bramka jakosci PRZED push na origin (wersjonowana kopia kanoniczna).
# INSTALACJA (po clone): ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
#
# Wzorzec 1:1 z assistant-v2, z trzema roznicami wynikajacymi z tego, ze repo startuje czyste:
#   - MYPY_BASELINE=0 (maszynownia ma 34; tutaj kazdy blad typow jest NOWY)
#   - brak M1/M1-lite (plan-delta per modul) — brain nie ma jeszcze modelu dwoch torow
#   - warstwowosc dokumentacyjna ZOSTAJE (lekcja 09.08: bramka blokujaca dopisek do .md
#     uczy uzywania `--no-verify`, czyli daje ZERO kontroli zamiast proporcjonalnej)
#
# Bramka biegnie na TYM SAMYM locku co CI (uv + --frozen). Bez tego wraca klasa
# "zielono lokalnie, czerwono w CI" (assistant-v2, main czerwony 29-30.07).
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)" || exit 0
cd "$REPO" || exit 0
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$REPO/.venv-uv}"
UV="$(command -v uv 2>/dev/null || true)"
[ -z "$UV" ] && [ -x "$HOME/.local/bin/uv" ] && UV="$HOME/.local/bin/uv"
if [ -z "$UV" ]; then
  printf '\033[31m%s\033[0m\n' "x brak uv -> bramka lokalna NIE MOZE byc lustrem CI."
  printf '\033[31m%s\033[0m\n' "  Zainstaluj: curl -LsSf https://astral.sh/uv/install.sh | sh"
  exit 1
fi
RUN="$UV run --frozen"
MYPY_BASELINE=0
LOG="/tmp/brain-prepush-pytest.log"
red(){ printf '\033[31m%s\033[0m\n' "$1"; }
grn(){ printf '\033[32m%s\033[0m\n' "$1"; }

# 0) Zakres pushu — decyduje, czy mypy+pytest sa potrzebne. WHITELISTA dokumentacyjna,
#    nie czarna lista kodu: nowy typ pliku domyslnie wpada w PELNA bramke (fail-safe).
ZERO="0000000000000000000000000000000000000000"
CHANGED=""
SAW_REF=0
while read -r _lref lsha _rref rsha; do
  [ "${lsha:-$ZERO}" = "$ZERO" ] && continue
  if [ "${rsha:-$ZERO}" = "$ZERO" ]; then
    base="$(git merge-base origin/main "$lsha" 2>/dev/null)"
    [ -z "$base" ] && base="$(git rev-list --max-parents=0 "$lsha" | tail -1)"
  else
    base="$rsha"
  fi
  SAW_REF=1
  CHANGED="$CHANGED$(git diff --name-only "$base".."$lsha" 2>/dev/null || true)"$'\n'
done

# Fail-safe #1: brak refow na stdin (hook odpalony recznie) = PELNA bramka.
# Fail-safe #2: PUSTA lista plikow = PELNA bramka. Zlapane na wlasnej skorze przy
#   commicie bootstrapujacym (12.08): dla PIERWSZEGO commita w repo `base` rowna sie
#   `lsha`, wiec `git diff base..lsha` zwraca pustke — a pusty zbior trywialnie spelnia
#   "wszystko pasuje do wzorca dokumentacyjnego" i bramka kodu ZNIKALA. Push z .py,
#   .toml i .yml przeszedl jako "sama dokumentacja". Nieznany zakres = pelna bramka,
#   nigdy odwrotnie.
DOC_ONLY=0
if [ "$SAW_REF" = "1" ]; then
  LISTA="$(printf '%s' "$CHANGED" | grep -v '^$' || true)"
  if [ -n "$LISTA" ]; then
    NONDOC="$(printf '%s' "$LISTA" | grep -vE '(\.md$|^docs/|\.txt$)' || true)"
    [ -z "$NONDOC" ] && DOC_ONLY=1
  fi
fi

# 1) LOCK
echo "> pre-push: uv lock --check"
if ! $UV lock --check >/dev/null 2>&1; then
  red "x uv.lock rozjechany z pyproject.toml -> push WSTRZYMANY."
  red "  Napraw: uv lock  (i zacommituj uv.lock razem ze zmiana zaleznosci)."
  exit 1
fi
grn "v lock zgodny z pyproject"

# 2) RUFF
echo "> pre-push: ruff check src/ tests/"
if ! $RUN ruff check src/ tests/; then
  red "x ruff zglosil bledy -> push WSTRZYMANY. Napraw albo: git push --no-verify"
  exit 1
fi
grn "v ruff clean"

# 3) MYPY (baseline 0 — repo startuje czyste)
if [ "$DOC_ONLY" = "1" ]; then
  grn "v mypy POMINIETY — zakres pushu to sama dokumentacja"
else
  echo "> pre-push: mypy src/ (baseline $MYPY_BASELINE)"
  MOUT="$($RUN mypy src/ 2>/dev/null)"
  CNT="$(printf '%s' "$MOUT" | grep -oE 'Found [0-9]+ error' | grep -oE '[0-9]+')"
  CNT="${CNT:-0}"
  if [ "$CNT" -gt "$MYPY_BASELINE" ]; then
    red "x mypy $CNT > baseline $MYPY_BASELINE -> push WSTRZYMANY (regres typow)."
    printf '%s\n' "$MOUT" | grep -E '^src/.*error:' | tail -15
    exit 1
  fi
  grn "v mypy $CNT <= baseline $MYPY_BASELINE"
fi

# 4) PYTEST (twardy blok, zero retry — lekcja F-0709-1)
if [ "$DOC_ONLY" = "1" ]; then
  grn "v pytest POMINIETY — zakres pushu to sama dokumentacja"
  printf '  pliki: %s\n' "$(printf '%s' "$CHANGED" | grep -v '^$' | tr '\n' ' ')"
  printf '  bramka kodu wraca automatycznie przy pierwszym pliku spoza wzorca .md/docs/.\n'
elif $RUN pytest -q >"$LOG" 2>&1; then
  grn "v pytest green"
else
  red "x pytest czerwony -> push WSTRZYMANY. Log: $LOG"
  tail -15 "$LOG"
  red "Test niedeterministyczny? Napraw przyczyne, nie dokladaj retry (lekcja F-0709-1)."
  exit 1
fi

grn "> pre-push: bramka zaliczona, pushuje."
exit 0
